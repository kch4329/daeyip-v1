# Database
# PostgreSQL 데이터베이스 연결 URL
# 형식: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:password@localhost:5432/daeyip?schema=public"

# Next.js
# 프로덕션 환경에서는 실제 도메인으로 변경
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT Secret (회원 인증용)
# 안전한 랜덤 문자열로 변경해야 합니다
JWT_SECRET="your-secret-key-here-change-this-in-production"

# Next-Auth Secret
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# bcrypt salt rounds (비밀번호 해싱)
BCRYPT_ROUNDS=10

# Google OAuth
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Kakao OAuth
# https://developers.kakao.com/console/app
KAKAO_CLIENT_ID="your-kakao-client-id"
KAKAO_CLIENT_SECRET="your-kakao-client-secret"
